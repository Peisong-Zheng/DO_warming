\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces  Fitted adjusted predictive Poisson event rates for (a) strong and (b) weak monsoon starts. Vertical lines mark observed event bins. Magenta curves show the extended baseline with event history, sampling resolution, LR04~\citep  {lisiecki2005pliocene}, \(\ce {CO2}\)~\citep  {bereiter2015revision}, and precession phase~\citep  {laskar2004long}; black curves show the extended model after adding Antarctic temperature, obliquity, eccentricity, and 65$^\circ $N summer-solstice insolation. The similar fitted rates and nonsignificant likelihood-ratio tests indicate that the extra forcings do not significantly improve the extended baseline. }}{11}{}\protected@file@percent }
\newlabel{fig:base_vs_extended_hazards}{{S6}{11}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Sensitivity of event-timing results to composite age uncertainty.} (a) Distribution of age perturbations applied to the published Rousseau et al.~\citep  {rousseau2023reliable} 0.4--4 kyr KS-window strong and weak monsoon-start ages, after rank-preserving truncation. (b) Fraction of 500 age-randomized catalogues for which each test remains significant at \(p<0.05\). Precession-phase clustering and adjusted predictive-information results remain significant for nearly all or all randomized catalogues, whereas the strong-start Lohmann randomness result is sensitive to the null-model choice.}}{11}{}\protected@file@percent }
\newlabel{fig:age_uncertainty_sensitivity}{{S7}{11}{}{figure.7}{}}
